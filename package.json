{
  "name": "workbuddy-console",
  "private": true,
  "version": "0.2.19",
  "description": "workbuddy控制台：账号切换、多平台免费模型广场、Token 与积分用量统计",
  "author": "walter-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walter-io/workbuddy-console.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:proxy": "node scripts/test-proxy.mjs",
    "test:key-probe": "node scripts/test-key-probe.mjs",
    "test:exe-discovery": "node scripts/test-exe-discovery.mjs",
    "test:auto-verify": "node scripts/test-auto-verify.mjs",
    "test:proxy-protocols": "node scripts/test-proxy-protocols.mjs",
    "test:proxy-pool": "node scripts/test-proxy-pool.mjs",
    "test:sessions": "node scripts/test-session-copy.mjs",
    "test:session-move": "node scripts/test-session-move.mjs",
    "test:session-cycle": "node scripts/test-session-cycle.mjs",
    "test:roundtrip": "node scripts/test-roundtrip-flow.mjs",
    "test:stop": "node scripts/test-stop-process.mjs",
    "test:refresh": "node scripts/test-token-refresh.mjs",
    "test:growth": "node scripts/test-growth.mjs",
    "test:app-update": "node scripts/test-app-update-event.mjs",
    "test:settings-event": "node scripts/test-settings-event.mjs",
    "app": "electron .",
    "app:dir": "npm run build && electron-builder --dir --publish never",
    "app:win": "npm run build && electron-builder --win --publish never",
    "app:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "express": "^4.21.0",
    "iconv-lite": "^0.4.24",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "volta": {
    "node": "20.20.2"
  }
}
